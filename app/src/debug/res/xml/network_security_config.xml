<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: permits plaintext HTTP to local dev backend hosts. Android blocks
     cleartext traffic by default for apps targeting API 28+, which is why every sync
     request failed instantly with "CLEARTEXT communication ... not permitted" instead
     of a network error. This file is under src/debug, so it never ships in release. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.180.182</domain>
    </domain-config>
</network-security-config>
